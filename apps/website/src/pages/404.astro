---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ButtonLink, TextLink } from '../ui/Button';
import { Eyebrow } from '../ui/Eyebrow';
import { Icon } from '../ui/Icon';
import { RowLink, RowLinks } from '../ui/RowLinks';
import { links, withBase } from '../lib/site';
---

<BaseLayout title="Page not found" description="This page does not exist on the easy-web-worker site." noindex>
  <div class="wrap px-5 pt-[110px] pb-[75px] text-center max-md:px-0 max-md:pt-[65px] max-md:pb-[30px]">
    <Eyebrow className="mb-[30px] justify-center">404 / Page not found</Eyebrow>
    <h1 class="text-[calc(60px*var(--type-scale))] max-md:text-[calc(43px*var(--type-scale))]">This path ends here.<br />Your next step doesn’t.</h1>
    <p class="mx-auto mb-[30px] max-w-[430px] text-17 leading-[1.7] max-md:text-14">
      The page may have moved, or the address may be incomplete.<br />Search for the concept you need, or start from the documentation.
    </p>
    <div class="mt-[30px] flex flex-wrap items-center justify-center gap-3">
      <button type="button" class="inline-flex min-h-[42px] items-center justify-center gap-[10px] rounded-control border border-ink bg-ink px-4 text-13 font-[550] whitespace-nowrap text-on-ink hover:bg-[#354239] dark:hover:bg-ink/85" data-dialog="search">
        <Icon name="search" /> Search the site
      </button>
      <ButtonLink icon="arrow" href={withBase('docs/')}>Browse docs</ButtonLink>
      <TextLink href={withBase()}>Back to home</TextLink>
    </div>
    <RowLinks className="mt-[70px] mb-0 text-left">
      <RowLink href={withBase('docs/getting-started/')} title="Getting started" text="Your first worker, step by step." />
      <RowLink href={withBase('examples/')} title="Interactive examples" text="Try the pattern you need." />
      <RowLink href={`${links.repo}/issues`} title="Report a broken link" text="Open an issue in the repository." external />
    </RowLinks>
  </div>
</BaseLayout>
