---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocsHub } from '../../ui/docs/DocsHub';
import { getDocsNav } from '../../lib/docs';

const { sections } = await getDocsNav();
const hubSections = sections.map((section) => ({
  title: section.title,
  pages: section.pages.map((page) => ({ id: page.id, title: page.data.title, description: page.data.description })),
}));
---

<BaseLayout
  image="og/docs.png"
  imageAlt="easy-web-worker documentation"
  title="Web Worker guides and API reference"
  description="Learn typed Web Workers, worker pools, transferable buffers, progress, and cancellation with easy-web-worker guides for JavaScript and TypeScript."
>
  <DocsHub sections={hubSections} />
</BaseLayout>
