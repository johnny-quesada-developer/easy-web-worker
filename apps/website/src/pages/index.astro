---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ResponsiveDemo } from '../examples/responsive/ResponsiveDemo';
import { ProgressDemo } from '../examples/progress/ProgressDemo';
import { PoolDemo } from '../examples/pool/PoolDemo';
import { CodeBlock } from '../ui/CodeBlock';
import { Icon } from '../ui/Icon';
import { ButtonLink } from '../ui/Button';
import { withBase } from '../lib/site';
import heroWorker from '@snippets/home/math.worker.ts?raw';
import heroMain from '@snippets/home/main.ts?raw';
import byHandWorker from '@snippets/home/by-hand.worker.js?raw';
import byHandMain from '@snippets/home/by-hand.main.js?raw';

/** The hero shows the two files as the README does: without the line that imports the library, and without `export` on the result. */
const asInReadme = (code: string) =>
  code
    .split('\n')
    .filter((line) => !line.includes("from 'easy-web-worker/"))
    .join('\n')
    .replace('export const result', 'const result')
    .trim();

const gettingStarted = withBase('docs/getting-started/');
const install = 'npm install easy-web-worker';

const essentials = [
  {
    icon: 'box',
    title: 'Move memory, not copies.',
    text: 'Pass an <code>ArrayBuffer</code> in the transfer list and it changes threads without being duplicated. Results can travel back the same way.',
    link: 'Transfer large data',
    href: withBase('docs/transferable-objects/'),
    tone: 'border-[#e7ecdf] dark:border-line bg-[#f5f7f2] dark:bg-soft text-[#718563] dark:text-muted',
  },
  {
    icon: 'code',
    title: 'A worker without a file.',
    text: 'Give <code>createWorker</code> a function and it becomes the worker. Same methods, same inferred types, nothing to configure.',
    link: 'Create runtime workers',
    href: withBase('docs/runtime-workers/'),
    tone: 'border-[#ece7db] dark:border-line bg-[#f8f6f0] dark:bg-soft text-[#887859] dark:text-amber',
  },
  {
    icon: 'branch',
    title: 'Your existing workers, too.',
    text: 'A URL, a native <code>Worker</code>, your own pool, or the message API you already use. Typed methods can sit on top of any of them.',
    link: 'See every way to create one',
    href: withBase('docs/creating-workers/'),
    tone: 'border-[#e8e5ef] dark:border-line bg-[#f5f4f8] dark:bg-blue-soft text-[#7b7897] dark:text-blue',
  },
] as const;

const questions = [
  {
    q: 'Is it a real Web Worker, or a simulation?',
    a: 'A real one. Every worker is a native <code>Worker</code> created by the browser, on its own thread. The library only replaces the message plumbing between both sides.',
  },
  {
    q: 'Does it depend on a framework or a bundler?',
    a: `No. It runs anywhere Web Workers do, with React, Vue, Angular, Svelte or none. Worker files follow the rules of your bundler; <a class="underline underline-offset-[3px]" href="${withBase('docs/creating-workers/')}">the guide lists each setup</a>.`,
  },
  {
    q: 'Can a call always be canceled?',
    a: `A cancellation is a message, and a worker stuck in a synchronous loop cannot receive it. Work that pauses can stop cleanly; for the rest you restart the worker. <a class="underline underline-offset-[3px]" href="${withBase('docs/cancellation-and-progress/')}">How cancellation works</a>.`,
  },
  {
    q: 'I already use createEasyWebWorker. Do I have to migrate?',
    a: 'No. The message API is still there and fully supported. Typed methods are built on top of it, and both can live in the same worker.',
  },
];

const textLink = 'inline-flex items-center gap-[9px] text-14 font-[550] text-ink hover:text-green [&_.arrow]:transition-transform [&_.arrow]:duration-200 hover:[&_.arrow]:translate-x-[3px]';
const installCopy =
  'mt-[17px] inline-flex items-center justify-center gap-3 rounded-[5px] px-[9px] py-[7px] font-mono text-11 leading-[1.4] text-muted hover:bg-soft hover:text-green max-sm:mt-3 max-sm:gap-[9px] max-sm:text-9';
const eyebrowLine = 'h-px w-[26px] bg-current';
const sectionTitle = 'mt-[18px] text-[calc(clamp(34px,3.55vw,49px)*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-lg:text-[calc(36px*var(--type-scale))] max-sm:mt-[15px] max-sm:text-[calc(35px*var(--type-scale))]';
const sectionText = 'mt-[22px] mb-0 max-w-[350px] text-15 leading-[1.85] text-muted max-lg:text-13 max-sm:mt-[19px] max-sm:max-w-[450px]';
const sectionNote = 'mt-[22px] mb-0 max-w-[350px] text-10 leading-[1.7] text-[#676c62] dark:text-muted max-sm:mt-[15px] max-sm:max-w-[440px] max-sm:text-9';
const stage = 'min-w-0 rounded-panel border border-line bg-soft p-[26px] max-lg:p-[18px] max-sm:p-[14px]';
const codeFrame = 'min-w-0 [&_.code-block]:m-0';
---

<BaseLayout
  image="og/home.png"
  imageAlt="easy-web-worker: Web Workers are powerful. Now they are also easy."
  title="easy-web-worker"
  description="Web Workers are powerful. Now they are also easy. easy-web-worker handles everything between the threads: message routing, promises, errors, cancellation, progress, transferable objects and worker pools."
  family="Product"
>
  <section class="wrap pt-[65px] text-center max-2xl:pt-[53px] max-sm:pt-[42px]" aria-labelledby="hero-title">
    <a
      class="inline-flex min-h-[29px] items-center gap-[9px] rounded-full border border-line bg-surface py-1 pr-[10px] pl-[9px] text-11 text-[#4f5d54] dark:text-muted hover:border-[#b6c9bc] dark:hover:border-line max-sm:gap-[6px] max-sm:text-10"
      href="#live"
    >
      <span class="rounded-[20px] bg-[#e9f0e9] dark:bg-green-soft px-[6px] py-1 font-mono text-9 leading-[1.2] text-green max-sm:text-8">LIVE</span>
      Same task. Two ways to run it.
      <Icon name="chevron" className="size-[13px] text-[#7b867e] dark:text-muted" />
    </a>
    <h1
      id="hero-title"
      class="mx-auto mt-6 mb-5 max-w-[1100px] text-[calc(clamp(56px,6.1vw,87px)*var(--type-scale))] leading-[1.025] font-[550] tracking-[-0.065em] max-2xl:text-[calc(76px*var(--type-scale))] max-lg:text-[calc(67px*var(--type-scale))] max-sm:mt-[23px] max-sm:mb-[18px] max-sm:text-[calc(clamp(39px,9.25vw,59px)*var(--type-scale))] max-sm:leading-[1.075] max-sm:tracking-[-0.06em] 4xl:text-[calc(91px*var(--type-scale))]"
    >
      Web Workers are powerful.<br /><span class="text-[#464e48] dark:text-muted">Now they're also easy.</span>
    </h1>
    <p class="mx-auto mb-0 max-w-[660px] text-17 leading-[1.75] tracking-[-0.2px] text-muted max-lg:max-w-[570px] max-lg:text-15 max-sm:max-w-[370px] max-sm:text-14 max-sm:leading-[1.8]">
      Let <code class="rounded-[4px] bg-[#f1f4ef] dark:bg-green-soft px-[5px] py-[2px] text-[0.86em] text-[#46544a] dark:text-muted">easy-web-worker</code> handle everything between the threads. You keep the power of native Web Workers without dealing with all the complexity that usually comes with them.
    </p>
    <p class="mx-auto mt-[14px] mb-0 max-w-[620px] text-13 leading-[1.8] text-[#6f796f] dark:text-muted max-lg:max-w-[540px] max-sm:max-w-[360px] max-sm:text-12">
      It handles the plumbing between both sides: message routing, request matching, promises, errors, cancellation, progress, transferable objects, lifecycle management, and worker pools.
    </p>
    <div class="mt-[26px] flex flex-wrap items-center justify-center gap-3 max-sm:mt-[22px] max-sm:gap-[9px]">
      <ButtonLink variant="primary" icon="arrow" className="min-h-12 px-[22px] text-14 max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href={gettingStarted}>Start building</ButtonLink>
      <a class="inline-flex min-h-12 items-center justify-center gap-3 rounded-control border border-line bg-paper px-[22px] text-14 font-[550] whitespace-nowrap hover:border-[#b7c2ba] dark:hover:border-line hover:bg-soft max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href="#live">
        <Icon name="play" className="size-[14px]" /> See it run
      </a>
    </div>
    <button type="button" class={installCopy} data-copy={install} aria-label="Copy npm install command">
      <span class="text-[#646c64] dark:text-muted">$</span><span>{install}</span><Icon name="copy" className="size-[13px] max-sm:size-3" />
    </button>

    <div class="mx-auto mt-[46px] grid grid-cols-2 gap-5 text-left max-lg:gap-[14px] max-sm:mt-[32px] max-sm:grid-cols-1">
      <div class={codeFrame}>
        <CodeBlock code={asInReadme(heroWorker)} lang="ts" title="math.worker.ts · you write this" />
      </div>
      <div class={codeFrame}>
        <CodeBlock code={asInReadme(heroMain)} lang="ts" title="main.ts · and call it like this" />
      </div>
    </div>

    <div class="mt-[41px] flex flex-wrap items-center justify-center gap-[27px] border-b border-line pb-[51px] text-11 text-[#6f796f] dark:text-muted max-lg:gap-[17px] max-sm:mt-[30px] max-sm:gap-x-5 max-sm:gap-y-[13px] max-sm:pb-9 max-sm:text-9" aria-label="Library capabilities">
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="bolt" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> Real native Workers</span>
      <span class="h-[13px] w-px bg-[#e2e7dd] dark:bg-line max-lg:hidden" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="check" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> TypeScript inference</span>
      <span class="h-[13px] w-px bg-[#e2e7dd] dark:bg-line max-lg:hidden" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="scope" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> Any framework</span>
      <span class="h-[13px] w-px bg-[#e2e7dd] dark:bg-line max-lg:hidden" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 max-sm:gap-[5px]"><Icon name="github" className="size-[14px] text-[#808d7a] dark:text-muted max-sm:size-3" /> Open source · ISC</span>
    </div>
  </section>

  <section class="wrap grid grid-cols-[.92fr_1.25fr] items-center gap-[93px] py-[103px] max-2xl:gap-12 max-lg:grid-cols-[1fr_1.2fr] max-lg:gap-10 max-sm:flex max-sm:flex-col max-sm:items-stretch max-sm:gap-[30px] max-sm:py-[66px]" id="live" aria-labelledby="live-title">
    <div class="min-w-0">
      <div class="eyebrow-mono"><span class={eyebrowLine}></span> A RESPONSIVE PAGE</div>
      <h2 id="live-title" class={sectionTitle}>The work is heavy.<br />The page<br />doesn't have to be.</h2>
      <p class={sectionText}>Same task, two ways to run it. On the main thread the page freezes until the answer arrives: no scrolling, no typing, no animation. In a Worker you get the same answer and the page never stops.</p>
      <a class={`${textLink} mt-[25px] text-12 max-sm:mt-[18px]`} href={withBase('examples/keep-the-page-responsive/')}>Open the full example <Icon name="arrow" className="arrow" /></a>
      <p class={sectionNote}>This runs in your browser, against the same package files that are published to npm.</p>
    </div>
    <div class={stage}>
      <ResponsiveDemo client:only="react">
        <p slot="fallback" class="m-0 grid min-h-[320px] place-items-center text-12 text-muted">Loading the live example…</p>
      </ResponsiveDemo>
    </div>
  </section>

  <section class="wrap border-t border-line py-[103px] max-sm:py-[66px]" id="functions" aria-labelledby="functions-title">
    <div class="mb-[35px] flex items-end justify-between gap-[42px] max-2xl:gap-[30px] max-lg:block max-sm:mb-[27px]">
      <div>
        <div class="eyebrow-mono text-[#586b89] dark:text-blue"><span class={eyebrowLine}></span> MESSAGES BECOME FUNCTIONS</div>
        <h2 id="functions-title" class={sectionTitle}>The native API gives you<br />messages. You wanted a function.</h2>
      </div>
      <div class="max-w-[400px] pb-[3px] max-2xl:max-w-[360px] max-lg:mt-[23px] max-lg:max-w-[520px] max-sm:mt-[18px]">
        <p class="m-0 text-15 leading-[1.85] text-muted max-sm:text-13 max-sm:leading-[1.9]">This is the least you write by hand to get one answer back from a Worker. And that is before errors, cancellation, progress, types, or a second method.</p>
        <a class={`${textLink} mt-[17px] text-12 max-sm:mt-[14px]`} href={withBase('docs/typed-workers/')}>See what replaces it <Icon name="arrow" className="arrow" /></a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-5 max-lg:gap-[14px] max-sm:grid-cols-1">
      <div class={codeFrame}>
        <CodeBlock code={byHandWorker.trimEnd()} lang="js" title="fibonacci.worker.js · by hand" />
      </div>
      <div class={codeFrame}>
        <CodeBlock code={byHandMain.trimEnd()} lang="js" title="main.js · by hand" />
      </div>
    </div>
  </section>

  <section class="wrap grid grid-cols-[1.25fr_.92fr] items-center gap-[93px] border-t border-line py-[103px] max-2xl:gap-12 max-lg:grid-cols-[1.2fr_1fr] max-lg:gap-10 max-sm:flex max-sm:flex-col max-sm:items-stretch max-sm:gap-[30px] max-sm:py-[66px]" id="progress" aria-labelledby="progress-title">
    <div class={stage}>
      <ProgressDemo client:only="react">
        <p slot="fallback" class="m-0 grid min-h-[320px] place-items-center text-12 text-muted">Loading the live example…</p>
      </ProgressDemo>
    </div>
    <div class="min-w-0 pl-[6px] max-sm:order-first max-sm:pl-0">
      <div class="eyebrow-mono"><span class={eyebrowLine}></span> PROGRESS AND CANCELLATION</div>
      <h2 id="progress-title" class={sectionTitle}>One call.<br />Its whole lifecycle.</h2>
      <p class={sectionText}>Every call returns a cancelable promise. Progress arrives through it, and canceling it tells the worker to stop. No second channel to invent.</p>
      <a class={`${textLink} mt-[25px] text-12 max-sm:mt-[18px]`} href={withBase('docs/cancellation-and-progress/')}>Cancel and report progress <Icon name="arrow" className="arrow" /></a>
      <p class={sectionNote}>The cancellation reaches the worker, so the work stops there instead of finishing for nobody.</p>
    </div>
  </section>

  <section class="wrap grid grid-cols-[.92fr_1.25fr] items-center gap-[93px] border-t border-line py-[103px] max-2xl:gap-12 max-lg:grid-cols-[1fr_1.2fr] max-lg:gap-10 max-sm:flex max-sm:flex-col max-sm:items-stretch max-sm:gap-[30px] max-sm:py-[66px]" id="pool" aria-labelledby="pool-title">
    <div class="min-w-0">
      <div class="eyebrow-mono text-[#586b89] dark:text-blue"><span class={eyebrowLine}></span> WORKER POOLS</div>
      <h2 id="pool-title" class={sectionTitle}>Every core.<br />One option.</h2>
      <p class={sectionText}>One worker runs one task at a time, so three searches wait in line. Set <code>maxWorkers</code> and the same object runs them on three native Workers at once. Same answers, sooner, and the calling code does not change.</p>
      <a class={`${textLink} mt-[25px] text-12 max-sm:mt-[18px]`} href={withBase('docs/worker-pools/')}>Scale with a pool <Icon name="arrow" className="arrow" /></a>
      <p class={sectionNote}>Workers are created as calls arrive, so an idle application pays for none of them.</p>
    </div>
    <div class={stage}>
      <PoolDemo client:only="react">
        <p slot="fallback" class="m-0 grid min-h-[320px] place-items-center text-12 text-muted">Loading the live example…</p>
      </PoolDemo>
    </div>
  </section>

  <section class="wrap border-t border-line pt-[75px] pb-[84px] max-sm:py-[60px]" aria-labelledby="essentials-title">
    <div class="mb-[33px] flex items-end justify-between gap-[25px] max-sm:mb-[30px] max-sm:block">
      <h2 id="essentials-title" class="max-w-[400px] text-[calc(31px*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-sm:text-[calc(28px*var(--type-scale))]">Simple to start.<br />Room for the real world.</h2>
      <p class="m-0 max-w-[300px] text-12 text-[#656c61] dark:text-muted max-sm:mt-4 max-sm:max-w-[400px]">Begin with one method. Reach for the rest only when the application needs it.</p>
    </div>
    <div class="grid grid-cols-3 gap-10 max-lg:gap-[19px] max-sm:flex max-sm:flex-col max-sm:gap-[27px]">
      {
        essentials.map((item) => (
          <article class="pr-5 [&+&]:border-l [&+&]:border-line [&+&]:pl-[30px] max-lg:pr-0 max-lg:[&+&]:pl-[21px] max-sm:relative max-sm:pr-0 max-sm:pb-6 max-sm:pl-[51px] max-sm:not-last:border-b max-sm:not-last:border-line max-sm:[&+&]:border-l-0 max-sm:[&+&]:pl-[51px]">
            <span class={`mb-4 grid size-[33px] place-items-center rounded-control border max-sm:absolute max-sm:top-0 max-sm:left-0 ${item.tone}`}>
              <Icon name={item.icon} className="size-[17px]" />
            </span>
            <h3 class="mb-[9px] text-16 font-[550] tracking-[-0.4px] max-lg:text-14 max-sm:text-15">{item.title}</h3>
            <p class="m-0 text-12 leading-[1.85] text-[#646d5d] dark:text-muted [&_code]:text-[0.9em] max-lg:text-11 max-sm:text-12" set:html={item.text} />
            <a class={`${textLink} mt-[15px] text-11 text-[#68775e] dark:text-muted max-sm:mt-[11px]`} href={item.href}>{item.link} <Icon name="arrow" className="arrow" /></a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap grid grid-cols-[.75fr_1.25fr] gap-[100px] border-t border-line pt-[67px] pb-20 max-2xl:gap-[65px] max-lg:grid-cols-[1fr_1.3fr] max-lg:gap-10 max-sm:grid-cols-1 max-sm:gap-[25px] max-sm:pt-[55px] max-sm:pb-[58px]" aria-labelledby="questions-title">
    <div>
      <h2 id="questions-title" class="text-[calc(29px*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-sm:text-[calc(27px*var(--type-scale))]">A few useful details.</h2>
      <p class="mt-[14px] mb-0 text-12 leading-[1.85] text-muted max-sm:mt-[10px]">No mystery around the small print.</p>
    </div>
    <div>
      {
        questions.map((item) => (
          <details class="border-b border-line first:border-t [&[open]_.icon]:rotate-45">
            <summary class="flex cursor-pointer items-center justify-between gap-[25px] py-[18px] text-12 font-medium max-sm:gap-[14px]">
              {item.q}
              <Icon name="plus" className="size-[13px] text-[#8a947f] dark:text-muted" />
            </summary>
            <p class="m-0 pb-[18px] text-12 leading-[1.9] text-muted [&_code]:text-10 max-sm:text-11" set:html={item.a} />
          </details>
        ))
      }
    </div>
  </section>

  <aside class="wrap flex items-center justify-between gap-8 rounded-[9px] border border-line bg-[#fbfcf9] dark:bg-surface px-8 py-[27px] max-sm:block max-sm:p-[22px]" aria-label="Project maintainer">
    <div class="flex items-center gap-[17px] max-sm:gap-[13px]">
      <span class="grid size-[45px] shrink-0 place-items-center overflow-hidden rounded-full border border-[#dde5d4] dark:border-line bg-[#eef3e7] dark:bg-green-soft max-sm:size-[37px]" aria-hidden="true">
        <img class="block size-full object-cover" src={withBase('img/avatar-head.png')} width="45" height="45" alt="" loading="lazy" decoding="async" />
      </span>
      <div>
        <h3 class="text-13 font-[550] tracking-normal max-sm:text-11">Independent software. Accountable craftsmanship.</h3>
        <p class="mt-[3px] mb-0 text-11 text-[#656d5c] dark:text-muted max-sm:text-10 max-sm:leading-[1.8]">Created and maintained by Johnny Quesada. Open code, real examples, and a direct line to the builder.</p>
      </div>
    </div>
    <a class={`${textLink} text-11 whitespace-nowrap max-sm:mt-[15px] max-sm:ml-[50px] max-sm:text-10`} href={withBase('about/')}>Meet the engineer <Icon name="up-right" className="arrow" /></a>
  </aside>

  <section class="wrap pt-24 pb-[86px] text-center max-sm:pt-[68px] max-sm:pb-[62px]" aria-labelledby="closing-title">
    <div class="eyebrow-mono justify-center">LESS PLUMBING. MORE WORK DONE.</div>
    <h2 id="closing-title" class="mt-[15px] text-[calc(clamp(35px,4.1vw,56px)*var(--type-scale))] leading-[1.1] font-[520] tracking-[-0.045em] max-sm:text-[calc(37px*var(--type-scale))]">Your next worker<br />starts here.</h2>
    <p class="mt-[17px] mb-0 text-14 text-[#646d5d] dark:text-muted max-sm:mt-[15px] max-sm:text-12">Write Worker code like an API. Call it like normal asynchronous JavaScript.</p>
    <div class="mt-[25px] flex flex-wrap items-center justify-center gap-3 max-sm:mt-[22px] max-sm:gap-[9px]">
      <ButtonLink variant="primary" icon="arrow" className="min-h-12 px-[22px] text-14 max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href={gettingStarted}>Get started</ButtonLink>
      <ButtonLink icon="arrow" className="min-h-12 px-[22px] text-14 max-sm:min-h-[45px] max-sm:px-[14px] max-sm:text-12" href={withBase('examples/')}>Explore the examples</ButtonLink>
    </div>
    <button type="button" class={`${installCopy} mt-[14px]`} data-copy={install} aria-label="Copy npm install command">
      <span class="text-[#646c64] dark:text-muted">$</span><span>{install}</span><Icon name="copy" className="size-[13px] max-sm:size-3" />
    </button>
  </section>
</BaseLayout>
