{
  "name": "easy-web-worker-website",
  "private": true,
  "version": "8.0.1",
  "type": "module",
  "description": "Documentation, examples and learning site for easy-web-worker. Deployed to GitHub Pages; never published to npm.",
  "scripts": {
    "search:index": "node scripts/dev-search-index.mjs",
    "dev": "yarn search:index && astro dev",
    "build": "astro build && rm -rf dist/pagefind && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "yarn build && playwright test",
    "test:visual:run": "playwright test",
    "test:visual:update": "yarn build && playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "ts-check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "validate": "yarn lint && yarn ts-check && yarn test && yarn build && yarn test:visual:run && yarn check:links",
    "make:og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "json-storage-formatter": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-global-state-hooks": "^16.0.6",
    "shiki": "^4.4.3",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@emnapi/runtime": "^1.7.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
